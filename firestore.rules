rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Curated listings: anyone can browse (this is a public homebuyer
    // site), but only a signed-in user can add/edit. Tighten this to a
    // real admin check (custom claim or users/{uid}.role) once there's an
    // actual admin role system — right now any authenticated account can
    // write, which is fine for a single-operator site but not for a team.
    match /listings/{listingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
